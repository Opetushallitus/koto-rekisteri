# Block lifecycle scripts (preinstall/install/postinstall) on dependencies —
# the main vector for npm supply-chain worms like shai-hulud.
ignore-scripts=true

# Refuse to install if Node/npm don't satisfy the "engines" field in
# package.json. Keeps CI and local installs on the version we've validated.
engine-strict=true

# `npm install <pkg>` writes the exact version into package.json instead of a
# caret range. Bumps then only happen via Renovate, which enforces the
# `minimumReleaseAge` cooldown in .github/renovate.json.
save-exact=true

# Fail `npm audit` on high/critical CVEs only (moderate noise is too high to
# act on in CI).
audit-level=high

# Suppress the donation messages — not security-related, just noise.
fund=false
